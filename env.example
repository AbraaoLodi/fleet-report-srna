# =============================================================================
# Configuração de ambiente — Fleet Report SRNA
# =============================================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser versionado (está no .gitignore).
# =============================================================================

# --- Conexão Snowflake (SSO via navegador) ---
SNOWFLAKE_ACCOUNT=sua_conta_snowflake        # ex: xxxxx-yyyyyyy
SNOWFLAKE_USER=seu.usuario@serenaenergia.com.br
SNOWFLAKE_AUTHENTICATOR=externalbrowser      # SSO — abre o navegador para login
SNOWFLAKE_ROLE=                              # opcional: role específica
SNOWFLAKE_WAREHOUSE=                         # opcional: warehouse
SNOWFLAKE_DATABASE=OEM_PROD                  # padrão do projeto
SNOWFLAKE_SCHEMA=                            # opcional

# --- Parâmetros do parque ---
CLUSTER_OEM=Assurua SG                          # cluster OEM alvo
N_WTGS_FROTA=49                                 # nº de WTGs nominais da frota

# --- Log ---
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
